platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__
  )

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found in Generated.xcconfig."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end

  target 'PrayerTimesWidget' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # --- AUTOMATIC FLUTTER VERSION INJECTION FOR WIDGET EXTENSION ---
  widget_configs = [
    'Pods/Target Support Files/Pods-PrayerTimesWidget/Pods-PrayerTimesWidget.debug.xcconfig',
    'Pods/Target Support Files/Pods-PrayerTimesWidget/Pods-PrayerTimesWidget.release.xcconfig',
    'Pods/Target Support Files/Pods-PrayerTimesWidget/Pods-PrayerTimesWidget.profile.xcconfig',
    'Pods/Target Support Files/Pods-Runner-PrayerTimesWidget/Pods-Runner-PrayerTimesWidget.debug.xcconfig',
    'Pods/Target Support Files/Pods-Runner-PrayerTimesWidget/Pods-Runner-PrayerTimesWidget.release.xcconfig',
    'Pods/Target Support Files/Pods-Runner-PrayerTimesWidget/Pods-Runner-PrayerTimesWidget.profile.xcconfig'
  ]

  include_statement = '#include? "../../../Flutter/Generated.xcconfig"'

  widget_configs.each do |config_path|
    full_path = File.join(__dir__, config_path)
    if File.exist?(full_path)
      content = File.read(full_path)
      unless content.include?(include_statement)
        File.open(full_path, 'a') do |file|
          file.puts "\n// Injected for Flutter version syncing\n"
          file.puts "#{include_statement}\n"
        end
      end
    end
  end

  # Also scan any other PrayerTimesWidget xcconfigs generated by CocoaPods
  Dir.glob(File.join(__dir__, 'Pods/Target Support Files/*PrayerTimesWidget*/*.xcconfig')).each do |full_path|
    if File.exist?(full_path)
      content = File.read(full_path)
      unless content.include?(include_statement)
        File.open(full_path, 'a') do |file|
          file.puts "\n// Injected for Flutter version syncing\n"
          file.puts "#{include_statement}\n"
        end
      end
    end
  end
end

